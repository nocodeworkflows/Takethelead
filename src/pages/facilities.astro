---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import TrustStrip from "../components/TrustStrip.astro";
import CtaBand from "../components/CtaBand.astro";
import { getSiteSettings, getFacilitiesPage } from "../lib/content";

const site = await getSiteSettings();
const fac = await getFacilitiesPage();

const ctaText = (fac?.ctaText || "").replace("{areasLabel}", site.areasLabel);
---

<BaseLayout title="Facilities" description={fac?.metaDescription || ""}>
  <!-- HERO -->
  <section class="page-hero">
    <div class="wrap">
      <p class="crumbs reveal"><a href="/">Home</a> &nbsp;/&nbsp; Facilities</p>
      <span class="eyebrow reveal">{fac?.heroEyebrow}</span>
      <h1 class="reveal">{fac?.heroHeading}</h1>
      <p class="lead reveal">{fac?.heroLead}</p>
    </div>
  </section>

  <!-- SECTION 1: The Daycare Facility -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">{fac?.daycareEyebrow}</span>
        <h2>{fac?.daycareHeading}</h2>
        <p>{fac?.daycareIntro}</p>
      </div>
      <ul class="feat-list reveal">
        {
          (fac?.daycareFeatures || []).map((f) => (
            <li>
              <span class="fic"><Icon name="check" /></span>
              <div>
                <h4>{f.title}</h4>
                <p>{f.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- SECTION 2: Private Woodland -->
  <section class="sec why">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">{fac?.woodlandEyebrow}</span>
        <h2>{fac?.woodlandHeading}</h2>
        <p set:html={fac?.woodlandIntro} />
      </div>
      <ul class="feat-list reveal">
        {
          (fac?.woodlandFeatures || []).map((f) => (
            <li>
              <span class="fic"><Icon name="check" /></span>
              <div>
                <h4>{f.title}</h4>
                <p>{f.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- SECTION 3: Safety & Credentials -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head center reveal">
        <span class="eyebrow">{fac?.safetyEyebrow}</span>
        <h2>{fac?.safetyHeading}</h2>
        <p>{fac?.safetyIntro}</p>
      </div>
    </div>
    <TrustStrip />
  </section>

  <CtaBand title={fac?.ctaTitle || undefined} text={ctaText || undefined} />
</BaseLayout>
