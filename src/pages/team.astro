---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import TrustStrip from "../components/TrustStrip.astro";
import CtaBand from "../components/CtaBand.astro";
import { getTeamMembers, getTeamPage } from "../lib/content";

const page = await getTeamPage();
const members = await getTeamMembers();
---

<BaseLayout title="Meet the Team" description={page?.metaDescription || ""}>
  <!-- HERO -->
  <section class="page-hero">
    <div class="wrap">
      <p class="crumbs reveal"><a href="/">Home</a> &nbsp;/&nbsp; Team</p>
      <span class="eyebrow reveal">{page?.heroEyebrow}</span>
      <h1 class="reveal">{page?.heroHeading}</h1>
      <p class="lead reveal">{page?.heroLead}</p>
    </div>
  </section>

  <!-- TEAM CARDS -->
  <!-- TODO: Replace with real team bios and photos before go-live -->
  <section class="sec">
    <div class="wrap">
      <div class="team-grid">
        {
          members.map((member) => (
            <article class="team-card reveal">
              {member.photo && member.photo !== "" ? (
                <div class="team-photo">
                  <img src={member.photo} alt={`${member.name} — ${member.role}`} loading="lazy" />
                </div>
              ) : (
                <div class="team-photo-placeholder">
                  <Icon name="paw" />
                </div>
              )}
              <div class="team-card-body">
                <h3 class="team-name">{member.name}</h3>
                <p class="team-role">{member.role}</p>
                <p class="team-bio">{member.bio}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <!-- TODO: Replace with real team bios and photos before go-live -->

  <!-- CREDENTIALS STRIP -->
  <TrustStrip />

  <!-- CTA -->
  <CtaBand />
</BaseLayout>

<style>
  .team-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: 2rem;
  }

  @media (min-width: 768px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .team-card {
    background: var(--surface);
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.07);
    display: flex;
    flex-direction: column;
  }

  .team-photo img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  .team-photo-placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: color-mix(in srgb, var(--red) 10%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--red);
  }

  .team-photo-placeholder :global(svg) {
    width: 4rem;
    height: 4rem;
    opacity: 0.5;
  }

  .team-card-body {
    padding: 1.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .team-name {
    font-size: 1.25rem;
    color: var(--ink);
    margin: 0;
  }

  .team-role {
    font-size: 0.9rem;
    color: var(--red);
    font-weight: 600;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .team-bio {
    font-size: 0.95rem;
    color: var(--ink);
    opacity: 0.75;
    margin: 0.5rem 0 0;
    line-height: 1.6;
  }
</style>
