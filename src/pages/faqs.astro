---
import BaseLayout from "../layouts/BaseLayout.astro";
import FAQ from "../components/FAQ.astro";
import CtaBand from "../components/CtaBand.astro";
import { getSiteSettings, getFaqsPage } from "../lib/content";

const site = await getSiteSettings();
const page = await getFaqsPage();
---

<BaseLayout title="FAQs" description={page?.metaDescription || ""}>
  <!-- HERO -->
  <section class="page-hero">
    <div class="wrap">
      <p class="crumbs reveal"><a href="/">Home</a> &nbsp;/&nbsp; FAQs</p>
      <span class="eyebrow reveal">{page?.heroEyebrow}</span>
      <h1 class="reveal">{page?.heroHeading}</h1>
      <p class="lead reveal">{page?.heroLead}</p>
    </div>
  </section>

  <!-- FAQ ACCORDION (component fetches its own data) -->
  <FAQ />

  <!-- CTA -->
  <CtaBand
    title="Still have a question?"
    text={`We're happy to chat. Call us on ${site.phoneDisplay} or send a message and we'll get back to you.`}
  />
</BaseLayout>
