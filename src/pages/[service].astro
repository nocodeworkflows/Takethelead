---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import TrustStrip from "../components/TrustStrip.astro";
import Reviews from "../components/Reviews.astro";
import CtaBand from "../components/CtaBand.astro";
import ContactForm from "../components/ContactForm.astro";
import { getSiteSettings, getServices, getImages, getStylishDog } from "../lib/content";

export async function getStaticPaths() {
  const services = await getServices();
  return services.map((s) => ({
    params: { service: s.slug },
    props: { service: s },
  }));
}

const { service } = Astro.props;
const site = await getSiteSettings();
const services = await getServices();
const images = await getImages();

// Use the service's own photo if set, otherwise the homepage hero photo.
const photo = service.photo || images.heroMain;
const area = service.seoArea || site.areasLabel;

const pricingNote =
  service.pricingNote ||
  "Every dog is different, so we tailor our care (and price) to your needs. Get in touch for a no-obligation quote and your free meet & greet.";

// Training has its own phone line; everything else uses the main number.
const isTraining = service.slug === "dog-training";
const phoneHref = isTraining && site.training.phoneDisplay ? site.training.phoneHref : site.phoneHref;
const phoneDisplay = isTraining && site.training.phoneDisplay ? site.training.phoneDisplay : site.phoneDisplay;

const others = services.filter((s) => s.slug !== service.slug);

const stylishDog = await getStylishDog();
---

<BaseLayout
  title={`${service.title} in ${area}`}
  description={service.excerpt || service.intro}
  image={photo}
>
  <section class="page-hero">
    <div class="wrap">
      <p class="crumbs reveal"><a href="/">Home</a> &nbsp;/&nbsp; {service.title}</p>
      <span class="eyebrow reveal">{service.tagline || "Our services"}</span>
      <h1 class="reveal">{service.title} in <em>{area}</em></h1>
      <p class="lead reveal">{service.intro}</p>
      <div class="hero-actions reveal">
        {service.bookingUrl ? (
          <a class="btn btn-red" href={service.bookingUrl} target="_blank" rel="noopener">Book online</a>
        ) : (
          <a class="btn btn-red" href="#contact">Enquire now</a>
        )}
        <a class="btn btn-ghost" href={phoneHref}>
          <Icon name="phone" /> {phoneDisplay}
        </a>
      </div>
    </div>
  </section>

  <TrustStrip />

  <section class="sec">
    <div class="wrap split">
      <div class="reveal">
        <span class="eyebrow">What's included</span>
        <h2 style="font-size:clamp(1.9rem,4vw,2.8rem);color:var(--ink);margin:.6rem 0 1rem">
          {isTraining ? "What we can help with" : "Everything your dog needs"}
        </h2>
        <div class="prose">
          <ul>
            {service.highlights.map((h) => <li>{h}</li>)}
          </ul>
        </div>
        {service.notes.length > 0 && (
          <div class="notes-box">
            <strong>Please note</strong>
            <ul>
              {service.notes.map((n) => <li>{n}</li>)}
            </ul>
          </div>
        )}
        {service.prices.length === 0 && (
          <div class="pricing-note">
            <strong>Pricing & availability:</strong> {pricingNote}
          </div>
        )}
      </div>
      <div class="ph reveal">
        <img src={photo} alt={`${service.title} with Take The Lead Services`} loading="lazy" />
      </div>
    </div>
  </section>

  {service.prices.length > 0 && (
    <section class="sec prices-sec">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">Prices</span>
          <h2>{service.short} prices</h2>
        </div>
        <div class="price-list reveal">
          {service.prices.map((p) => (
            <div class="price-row">
              <div>
                <h3>{p.label}</h3>
                {p.detail && <p>{p.detail}</p>}
              </div>
              <span class="price">{p.price}</span>
            </div>
          ))}
        </div>
        <p class="pricing-note price-foot reveal">{pricingNote}</p>
      </div>
    </section>
  )}

  {service.areas.length > 0 && (
    <section class="sec service-areas">
      <div class="wrap center reveal">
        <span class="eyebrow">Where we cover</span>
        <h2>Areas covered for {service.short.toLowerCase()}</h2>
        <div class="chips">
          {service.areas.map((a) => <span class="chip">{a}</span>)}
        </div>
        <p class="areas-foot">Just outside these areas? <a href="#contact">Ask us</a>, we may still be able to help.</p>
      </div>
    </section>
  )}

  {service.gallery.length > 0 && (
    <section class="sec gallery-sec">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">Gallery</span>
          <h2>A look at {service.short.toLowerCase()} with us</h2>
        </div>
        <div class="gallery">
          {service.gallery.map((g) => (
            <figure class="reveal">
              <img src={g.src} alt={g.caption || `${service.title} at Take The Lead Services`} loading="lazy" />
              {g.caption && <figcaption>{g.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- The Stylish Dog sub-brand section (grooming only) -->
  {service.slug === "dog-grooming" && (
    <section class="sec stylish-dog-band">
      <div class="wrap center">
        <span class="eyebrow">{stylishDog?.eyebrow}</span>
        <h2 class="stylish-dog-name">
          <Icon name="scissors" /> {stylishDog?.heading}
        </h2>
        <p class="lead">{stylishDog?.tagline}</p>
        <p style="margin-top:1rem"><a class="svc-link" href="/terms/#grooming">Grooming terms &amp; conditions <Icon name="arrow" /></a></p>
      </div>
    </section>
  )}

  <!-- Other services -->
  <section class="sec why">
    <div class="wrap">
      <div class="sec-head center reveal">
        <span class="eyebrow">Explore more</span>
        <h2>Other ways we can help</h2>
      </div>
      <div class="svc-grid">
        {
          others.slice(0, 3).map((s) => (
            <article class="svc reveal">
              <span class="ic"><Icon name={s.icon} /></span>
              <h3>{s.title}</h3>
              <p>{s.excerpt}</p>
              <a class="svc-link" href={`/${s.slug}/`}>Learn more <Icon name="arrow" /></a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Reviews limit={3} />

  <!-- Inline booking -->
  <section class="sec contact" id="contact">
    <div class="wrap">
      <div class="sec-head center reveal">
        <span class="eyebrow">Get started</span>
        <h2 style="color:var(--ink)">Enquire about {service.title.toLowerCase()}</h2>
        <p>
          Tell us about your dog and we'll get back to you. Prefer to talk? Call{" "}
          <a href={phoneHref} style="color:var(--red);font-weight:700">{phoneDisplay}</a>.
        </p>
      </div>
      <div style="max-width:680px;margin:0 auto" class="reveal">
        <ContactForm preselect={service.slug} />
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .notes-box {
    background: var(--paper-2);
    border-left: 4px solid var(--red);
    border-radius: 12px;
    padding: 1rem 1.2rem;
    margin-top: 1.2rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .notes-box strong { color: var(--ink); display: block; margin-bottom: 0.4rem; }
  .notes-box ul { margin: 0; padding-left: 1.1rem; }
  .notes-box li { margin-bottom: 0.35rem; }
  .price-list {
    max-width: 780px;
    margin: 0 auto;
    background: var(--card);
    border: 1px solid var(--cream-line);
    border-radius: 18px;
    overflow: hidden;
  }
  .price-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.1rem 1.4rem;
    border-bottom: 1px solid var(--cream-line);
  }
  .price-row:last-child { border-bottom: 0; }
  .price-row h3 { font-family: "Hanken Grotesk"; font-weight: 800; font-size: 1.08rem; color: var(--ink); margin: 0 0 0.2rem; }
  .price-row p { color: var(--ink-soft); font-size: 0.93rem; margin: 0; }
  .price-row .price { font-family: "Fraunces", serif; font-weight: 600; font-size: 1.3rem; color: var(--red); white-space: nowrap; }
  .price-foot { max-width: 780px; margin: 1rem auto 0; }
  .service-areas .chips { justify-content: center; margin-top: 1.2rem; }
  .areas-foot { margin-top: 1rem; color: var(--ink-soft); }
  .areas-foot a { color: var(--red); font-weight: 700; }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.9rem;
  }
  .gallery figure { margin: 0; border-radius: 14px; overflow: hidden; background: var(--char); position: relative; }
  .gallery img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; display: block; }
  .gallery figcaption {
    position: absolute; left: 0; right: 0; bottom: 0;
    padding: 0.5rem 0.75rem;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
    color: #fff; font-size: 0.85rem;
  }
  @media (max-width: 560px) {
    .gallery { grid-template-columns: repeat(2, 1fr); }
    .price-row { flex-direction: column; gap: 0.3rem; }
  }
  .stylish-dog-band {
    background: var(--surface, #faf9f7);
    text-align: center;
  }
  .stylish-dog-name {
    font-style: italic;
    font-size: clamp(2rem, 5vw, 3.2rem);
    color: var(--ink);
    margin: .5rem 0 1rem;
  }
</style>
