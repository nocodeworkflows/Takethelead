---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import TrustStrip from "../components/TrustStrip.astro";
import Reviews from "../components/Reviews.astro";
import CtaBand from "../components/CtaBand.astro";
import { getSiteSettings, getWhyFeatures, getAboutPage, getImages } from "../lib/content";
import { emphasis } from "../lib/emphasis";

const site = await getSiteSettings();
const whyFeatures = await getWhyFeatures();
const ab = await getAboutPage();
const images = await getImages();
---

<BaseLayout
  title="About Us"
  description={`Meet the family behind ${site.name} — vet-nurse-led, fully licensed dog care across ${site.areasLabel}.`}
>
  <section class="page-hero">
    <div class="wrap">
      <p class="crumbs reveal"><a href="/">Home</a> &nbsp;/&nbsp; About</p>
      <span class="eyebrow reveal">{ab?.heroEyebrow}</span>
      <h1 class="reveal" set:html={emphasis(ab?.heroHeading)} />
      <p class="lead reveal">{ab?.heroLead}</p>
    </div>
  </section>

  <TrustStrip />

  <section class="sec">
    <div class="wrap split">
      <div class="reveal prose">
        <span class="eyebrow">{ab?.bodyEyebrow}</span>
        <h2 style="font-size:clamp(1.9rem,4vw,2.8rem);color:var(--ink);margin:.6rem 0 1rem">
          {ab?.bodyHeading}
        </h2>
        {(ab?.bodyParagraphs || []).map((p) => <p>{p}</p>)}
      </div>
      <div class="ph reveal">
        <img src={images.about} alt="The team at Take The Lead Services" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="sec why">
    <div class="wrap">
      <div class="sec-head center reveal">
        <span class="eyebrow">{ab?.promiseEyebrow}</span>
        <h2>{ab?.promiseHeading}</h2>
      </div>
      <div class="svc-grid">
        {
          whyFeatures.map((f) => (
            <article class="svc reveal">
              <span class="ic"><Icon name={f.icon} /></span>
              <h3 style="font-size:1.25rem">{f.title}</h3>
              <p>{f.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Reviews limit={3} />

  <CtaBand title={ab?.ctaTitle || undefined} text={ab?.ctaText || undefined} />
</BaseLayout>
