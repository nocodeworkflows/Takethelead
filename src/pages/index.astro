---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import TrustStrip from "../components/TrustStrip.astro";
import Reviews from "../components/Reviews.astro";
import FAQ from "../components/FAQ.astro";
import CtaBand from "../components/CtaBand.astro";
import {
  getSiteSettings,
  getServices,
  getAreas,
  getSteps,
  getWhyFeatures,
  getHomepage,
  getImages,
} from "../lib/content";
import { emphasis } from "../lib/emphasis";

const site = await getSiteSettings();
const services = await getServices();
const areas = await getAreas();
const steps = await getSteps();
const whyFeatures = await getWhyFeatures();
const hp = await getHomepage();
const images = await getImages();
---

<BaseLayout>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy reveal">
        <span class="eyebrow">{hp?.heroEyebrow}</span>
        <h1 set:html={emphasis(hp?.heroHeading)} />
        <p class="lead">{hp?.heroLead}</p>
        <div class="hero-badges">
          {(hp?.heroBadges || []).map((b) => (
            <span class="pill"><Icon name="check" />{b}</span>
          ))}
        </div>
        <div class="hero-actions">
          <a class="btn btn-red" href="/contact/">Book a Free Trial Day</a>
          <a class="btn btn-ghost" href="#services">Explore Services</a>
        </div>
        <div class="hero-rating">
          <span class="stars">★★★★★</span>
          <span>{hp?.ratingText}</span>
        </div>
      </div>

      <div class="hero-media reveal">
        <div class="hero-photo">
          <img
            src={images.heroMain}
            alt="A happy dog enjoying day care at Take The Lead Services' private woodland"
            width="720"
            height="540"
            fetchpriority="high"
          />
        </div>
        <div class="float-top">
          <b>{hp?.floatTopNumber}</b><span>{hp?.floatTopLabel}</span>
        </div>
        <div class="float-card">
          <span class="ic"><Icon name="heart" /></span>
          <div>
            <b>{hp?.floatCardTitle}</b>
            <span>{hp?.floatCardText}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <TrustStrip />

  <!-- SERVICES -->
  <section class="sec" id="services">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">{hp?.servicesEyebrow}</span>
        <h2>{hp?.servicesHeading}</h2>
        <p>{hp?.servicesIntro}</p>
      </div>
      <div class="svc-grid">
        {
          services.map((s) => (
            <article class={`svc reveal${s.feature ? " feat" : ""}`}>
              <span class="ic"><Icon name={s.icon} /></span>
              {s.tagline && <span class="svc-tag">{s.tagline}</span>}
              <h3>{s.title}</h3>
              <p>{s.excerpt}</p>
              <a class="svc-link" href={`/${s.slug}/`}>
                Learn more <Icon name="arrow" />
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- WHY US -->
  <section class="sec why" id="why">
    <div class="wrap why-grid">
      <div class="why-media reveal">
        <div class="ph tall"><img src={images.whyTall} alt="Dogs playing in secure woodland" loading="lazy" /></div>
        <div class="ph"><img src={images.whySquare1} alt="A dog being cared for" loading="lazy" /></div>
        <div class="ph"><img src={images.whySquare2} alt="A relaxed dog at home boarding" loading="lazy" /></div>
      </div>
      <div class="reveal">
        <span class="eyebrow">{hp?.whyEyebrow}</span>
        <h2 style="font-size:clamp(2rem,4.4vw,3.1rem);color:var(--ink);margin:.6rem 0">{hp?.whyHeading}</h2>
        <p style="color:var(--ink-soft);font-size:1.08rem">{hp?.whyIntro}</p>
        <ul class="feat-list">
          {
            whyFeatures.map((f) => (
              <li>
                <span class="fic"><Icon name={f.icon} /></span>
                <div>
                  <h4>{f.title}</h4>
                  <p>{f.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="sec" id="how">
    <div class="wrap">
      <div class="sec-head center reveal">
        <span class="eyebrow">{hp?.howEyebrow}</span>
        <h2>{hp?.howHeading}</h2>
        <p>{hp?.howIntro}</p>
      </div>
      <div class="steps">
        {
          steps.map((s, i) => (
            <article class="step reveal">
              <span class="num">{i + 1}</span>
              <span class="sic"><Icon name={s.icon} /></span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </article>
          ))
        }
      </div>
      <div class="steps-cta">
        <a class="btn btn-red" href="/contact/">Start with a Free Trial</a>
      </div>
    </div>
  </section>

  <Reviews />

  <!-- AREAS -->
  <section class="sec" id="areas">
    <div class="wrap areas-grid">
      <div class="reveal">
        <span class="eyebrow">{hp?.areasEyebrow}</span>
        <h2 style="font-size:clamp(2rem,4.4vw,3.1rem);color:var(--ink);margin:.6rem 0">{hp?.areasHeading}</h2>
        <p style="color:var(--ink-soft);font-size:1.08rem">{hp?.areasIntro}</p>
        <div class="chips">
          {areas.map((a) => <span class="chip">{a}</span>)}
        </div>
      </div>
      <div class="area-card reveal">
        <h3>{hp?.areaCardTitle}</h3>
        <p>{hp?.areaCardText}</p>
        {(hp?.areaCardRows || []).map((row) => (
          <div class="ac-row"><Icon name={row.icon} /> {row.text}</div>
        ))}
        <a class="btn btn-light" href="/contact/" style="margin-top:1.4rem">Check Availability</a>
      </div>
    </div>
  </section>

  <FAQ />

  <CtaBand />
</BaseLayout>
