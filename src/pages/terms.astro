---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";

// Adapted from the terms published on the original Weebly site.
const general = [
  "Our introductory meeting and assessment is free of charge, along with our key holding service. If you do not wish for us to hold your keys securely, a collection and drop-off fee will be charged each time we need the keys to provide a service.",
  "Bank holidays, Christmas and New Year are charged at double rate.",
  "Walks and daycare must be cancelled 48 hours in advance, otherwise a 50% cancellation fee is charged.",
  "Home boarding must be cancelled with 4 weeks' notice, otherwise a 50% cancellation fee is charged.",
  "Refunds for pet sitting will not be given if you come back before the end date confirmed at the time of booking.",
  "In an emergency with your pet we will try to contact you or your alternative contact. If we cannot reach you, we reserve the right to act on your behalf with a veterinary surgeon's advice.",
  "You leave your pets and your home with Take The Lead Services at your own risk.",
  "When visiting your home we will always make sure the house is locked and secure as per your instructions.",
  "Dogs must wear a secure collar with a tag showing your details. We also give every dog a tag with our details while in our care.",
  "Permission to let dogs off lead must be agreed in advance.",
  "While the care and safety of the dogs in our care is of the highest importance, we cannot be held responsible for accidental injury, and you are responsible for any veterinary fees incurred by your pet.",
  "Your dog's behaviour must be explained openly and honestly. We are happy to work with dogs with behavioural issues, but we must know in advance before putting other dogs or ourselves at risk.",
  "If your dog shows signs of aggression we have not been made aware of and causes harm to any person or animal while in our care, you will be responsible for any costs incurred. We highly recommend your dog is insured, including third-party liability.",
  "While every care will be given to your pet(s), they are looked after entirely at your own risk. You authorise us to call a veterinary surgeon on your behalf and at your expense should it be necessary.",
];

const grooming = [
  "The owner agrees that the dog is fit and healthy. Grooming of sick or elderly dogs is entirely at the owner's risk. Grooming may expose underlying skin or health problems that we cannot be held liable for. You must tell us of any changes before each groom.",
  "We reserve the right not to accept a dog that presents a risk of injury to itself or our staff.",
  "Any pre-existing coat or health conditions will be discussed. If you prefer a particular shampoo, please supply it at your own expense.",
  "De-matting policy: removing matting is essential to treat and prevent hotspots, sores, infections, infestations, eczema, scalding and severe itching. We reserve the right to de-mat and shave the coat very short to properly groom a severely affected coat. This is not routine, your dog may look very different afterwards, and it may expose pre-existing skin complaints. We will seek your consent before doing this.",
  "Style: every effort will be made to groom your dog to your expectations, but no guarantee can be given. We accept no responsibility for a groom carried out to your instructions but not to your visual expectations. It may take several sessions for the coat to grow to your desired style.",
  "Safety: all dogs are treated with the utmost care and kept safe and secure. We only use superior quality products. We will not continue a groom on a dog that becomes severely anxious or aggressive. We recommend owners have dog insurance.",
  "We may need to use a muzzle for your dog's safety and the groomer's. Our muzzles are comfortable and allow your dog to breathe normally and drink.",
  "We supply bowls and fresh water to prevent dogs becoming dehydrated.",
  "Cancellations: appointments cancelled with less than 24 hours' notice may be charged. Please cancel as far ahead as possible.",
  "Costs: we can estimate costs when you book, subject to reassessment on the day. With your agreement, prices may be adjusted for your dog's size, coat condition, style and time needed. Payment is due in full when you collect your dog. We accept cash and card.",
  "You agree to photographs of your dog being taken and used on the Take The Lead Services website and The Stylish Dog Grooming Facebook page.",
  "We respect your confidentiality and will not share your details without your prior consent.",
];
---

<BaseLayout
  title="Terms & Conditions"
  description="Terms and conditions for Take The Lead Services dog care and The Stylish Dog grooming salon."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="crumbs reveal"><a href="/">Home</a> &nbsp;/&nbsp; Terms</p>
      <span class="eyebrow reveal">The small print</span>
      <h1 class="reveal">Terms &amp; Conditions</h1>
      <p class="lead reveal">
        Please read these before booking. If anything is unclear, give us a call and we'll talk it through.
      </p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap prose terms">
      <h2 id="general">General terms</h2>
      <ol>{general.map((t) => <li>{t}</li>)}</ol>

      <h2 id="grooming">Dog grooming terms (The Stylish Dog)</h2>
      <ol>{grooming.map((t) => <li>{t}</li>)}</ol>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .terms h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); color: var(--ink); margin: 0 0 1rem; scroll-margin-top: 100px; }
  .terms h2 + ol { margin-bottom: 2.6rem; }
  .terms ol { padding-left: 1.3rem; }
  .terms li { color: var(--ink-soft); margin-bottom: 0.75rem; line-height: 1.6; }
</style>
