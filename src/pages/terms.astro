---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";

import { getTerms } from "../lib/content";

const t = await getTerms();
const general = t?.general || [];
const grooming = t?.grooming || [];
---

<BaseLayout
  title="Terms & Conditions"
  description="Terms and conditions for Take The Lead Services dog care and The Stylish Dog grooming salon."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="crumbs reveal"><a href="/">Home</a> &nbsp;/&nbsp; Terms</p>
      <span class="eyebrow reveal">The small print</span>
      <h1 class="reveal">Terms &amp; Conditions</h1>
      <p class="lead reveal">{t?.heroLead}</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap prose terms">
      <h2 id="general">{t?.generalHeading || "General terms"}</h2>
      <ol>{general.map((t) => <li>{t}</li>)}</ol>

      <h2 id="grooming">{t?.groomingHeading || "Dog grooming terms"}</h2>
      <ol>{grooming.map((t) => <li>{t}</li>)}</ol>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .terms h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); color: var(--ink); margin: 0 0 1rem; scroll-margin-top: 100px; }
  .terms h2 + ol { margin-bottom: 2.6rem; }
  .terms ol { padding-left: 1.3rem; }
  .terms li { color: var(--ink-soft); margin-bottom: 0.75rem; line-height: 1.6; }
</style>
