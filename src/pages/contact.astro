---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import ContactForm from "../components/ContactForm.astro";
import FAQ from "../components/FAQ.astro";
import { getSiteSettings, getContactPage } from "../lib/content";
import { emphasis } from "../lib/emphasis";
const site = await getSiteSettings();
const cp = await getContactPage();
---

<BaseLayout
  title="Contact & Booking"
  description={`Book a free trial day or get a quote. Call ${site.phoneDisplay} or message ${site.name} — covering ${site.areasLabel}.`}
>
  <section class="page-hero">
    <div class="wrap">
      <p class="crumbs reveal"><a href="/">Home</a> &nbsp;/&nbsp; Contact</p>
      <span class="eyebrow reveal">{cp?.heroEyebrow}</span>
      <h1 class="reveal" set:html={emphasis(cp?.heroHeading)} />
      <p class="lead reveal">{cp?.heroLead}</p>
    </div>
  </section>

  <section class="sec contact">
    <div class="wrap contact-grid">
      <div class="reveal">
        <span class="eyebrow">{cp?.sideEyebrow}</span>
        <h2>{cp?.sideHeading}</h2>
        <p class="lead">{cp?.sideText}</p>

        <div class="contact-card">
          <span class="ic"><Icon name="phone" /></span>
          <div>
            <b>Call or text</b>
            <a href={site.phoneHref}>{site.phoneDisplay}</a>
          </div>
        </div>
        <div class="contact-card">
          <span class="ic"><Icon name="whatsapp" /></span>
          <div>
            <b>WhatsApp</b>
            <a href={site.whatsappHref} target="_blank" rel="noopener">Message us on WhatsApp</a>
          </div>
        </div>
        <div class="contact-card">
          <span class="ic"><Icon name="mail" /></span>
          <div>
            <b>Email</b>
            <a href={site.emailHref}>{site.email}</a>
          </div>
        </div>
        <div class="contact-card">
          <span class="ic"><Icon name="pin" /></span>
          <div>
            <b>Areas covered</b>
            <span>{site.areasLabel} & surrounding villages</span>
          </div>
        </div>
        <div class="contact-card">
          <span class="ic"><Icon name="clock" /></span>
          <div>
            <b>Opening hours</b>
            {site.hours.map((h) => <span style="display:block">{h.day}: {h.time}</span>)}
          </div>
        </div>
      </div>

      <div class="reveal">
        <ContactForm />
      </div>
    </div>
  </section>

  <section class="sec booking-portal">
    <div class="wrap center">
      <h2>{cp?.bookingHeading}</h2>
      <p>{cp?.bookingText}</p>
      {/* TODO: Set bookingUrl in Keystatic (Contact page) to the real PetSitterPlus portal URL before go-live */}
      <a href={cp?.bookingUrl} class="btn btn-ghost" target="_blank" rel="noopener">{cp?.bookingButtonLabel}</a>
    </div>
  </section>

  <FAQ />
</BaseLayout>
