---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import ContactForm from "../components/ContactForm.astro";
import FAQ from "../components/FAQ.astro";
import { getSiteSettings, getContactPage, getAreas } from "../lib/content";
import { emphasis } from "../lib/emphasis";
const site = await getSiteSettings();
const cp = await getContactPage();
const areas = await getAreas();
---

<BaseLayout
  title="Contact & Booking"
  description={`Book a free meet & greet or get a quote. Call ${site.phoneDisplay} or message ${site.name}, covering ${site.areasLabel} and nearby.`}
>
  <section class="page-hero">
    <div class="wrap">
      <p class="crumbs reveal"><a href="/">Home</a> &nbsp;/&nbsp; Contact</p>
      <span class="eyebrow reveal">{cp?.heroEyebrow}</span>
      <h1 class="reveal" set:html={emphasis(cp?.heroHeading)} />
      <p class="lead reveal">{cp?.heroLead}</p>
    </div>
  </section>

  <section class="sec contact">
    <div class="wrap contact-grid">
      <div class="reveal">
        <span class="eyebrow">{cp?.sideEyebrow}</span>
        <h2>{cp?.sideHeading}</h2>
        <p class="lead">{cp?.sideText}</p>

        <div class="contact-card">
          <span class="ic"><Icon name="phone" /></span>
          <div>
            <b>Boarding, day care, walking, grooming & cat sitting</b>
            <a href={site.phoneHref}>{site.phoneDisplay}</a>
            <a href={site.emailHref} style="display:block">{site.email}</a>
          </div>
        </div>
        {site.training.phoneDisplay && (
          <div class="contact-card">
            <span class="ic"><Icon name="star" /></span>
            <div>
              <b>Dog training</b>
              <a href={site.training.phoneHref}>{site.training.phoneDisplay}</a>
              {site.training.email && <a href={site.training.emailHref} style="display:block">{site.training.email}</a>}
            </div>
          </div>
        )}
        {site.whatsappHref && (
          <div class="contact-card">
            <span class="ic"><Icon name="whatsapp" /></span>
            <div>
              <b>WhatsApp</b>
              <a href={site.whatsappHref} target="_blank" rel="noopener">Message us on WhatsApp</a>
            </div>
          </div>
        )}
        {site.social.facebook && (
          <div class="contact-card">
            <span class="ic"><Icon name="facebook" /></span>
            <div>
              <b>Facebook</b>
              <a href={site.social.facebook} target="_blank" rel="noopener">facebook.com/taketheleadservices</a>
            </div>
          </div>
        )}
        <div class="contact-card">
          <span class="ic"><Icon name="pin" /></span>
          <div>
            <b>Day care areas</b>
            <span>{areas.join(", ")}</span>
          </div>
        </div>
        {site.salonAddress && (
          <div class="contact-card">
            <span class="ic"><Icon name="scissors" /></span>
            <div>
              <b>The Stylish Dog grooming salon</b>
              <span>{site.salonAddress}</span>
            </div>
          </div>
        )}
        {site.hours.length > 0 && (
          <div class="contact-card">
            <span class="ic"><Icon name="clock" /></span>
            <div>
              <b>Opening hours</b>
              {site.hours.map((h) => <span style="display:block">{h.day}: {h.time}</span>)}
            </div>
          </div>
        )}
      </div>

      <div class="reveal">
        <ContactForm />
      </div>
    </div>
  </section>

  <section class="sec booking-portal">
    <div class="wrap center">
      <h2>{cp?.bookingHeading}</h2>
      <p>{cp?.bookingText}</p>
      <div class="hero-actions" style="justify-content:center">
        {cp?.bookingUrl && (
          <a href={cp.bookingUrl} class="btn btn-red" target="_blank" rel="noopener">{cp?.bookingButtonLabel}</a>
        )}
        {cp?.trainingBookingUrl && (
          <a href={cp.trainingBookingUrl} class="btn btn-ghost" target="_blank" rel="noopener">Training booking form</a>
        )}
        {cp?.vaccinationUrl && (
          <a href={cp.vaccinationUrl} class="btn btn-ghost" target="_blank" rel="noopener">Send vaccination records</a>
        )}
      </div>
      <p style="margin-top:1rem"><a href="/terms/" style="color:var(--red);font-weight:700">Read our terms &amp; conditions</a></p>
    </div>
  </section>

  <FAQ limit={6} />
</BaseLayout>
