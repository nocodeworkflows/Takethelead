---
import Icon from "./Icon.astro";
const items = [
  { icon: "shield", label: "Fully Licensed & Insured" },
  { icon: "heart", label: "Vet-Nurse Led" },
  { icon: "check", label: "DBS Checked" },
  { icon: "tree", label: "Secure 4-Acre Woodland" },
  { icon: "star", label: "5★ Rated Locally" },
];
---

<section class="trust">
  <div class="wrap trust-row">
    {
      items.map((i) => (
        <span class="trust-item">
          <Icon name={i.icon} />
          {i.label}
        </span>
      ))
    }
  </div>
</section>
