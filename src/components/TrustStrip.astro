---
import Icon from "./Icon.astro";
import { getTrustItems } from "../lib/content";
const items = await getTrustItems();
---

<section class="trust">
  <div class="wrap trust-row">
    {
      items.map((i) => (
        <span class="trust-item">
          <Icon name={i.icon} />
          {i.label}
        </span>
      ))
    }
  </div>
</section>
