---
import { site } from "../data/site";
interface Props {
  title?: string;
  text?: string;
}
const {
  title = "Ready to give your dog the best day out?",
  text = "Book a free meet & greet and trial day — no pressure, no cost. See why local dogs love it here.",
} = Astro.props;
---

<section class="cta-band">
  <div class="wrap reveal">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-actions">
      <a class="btn btn-light" href="/contact/">Book a Free Trial</a>
      <a class="btn btn-outline-light" href={site.phoneHref}>Call {site.phoneDisplay}</a>
    </div>
  </div>
</section>
