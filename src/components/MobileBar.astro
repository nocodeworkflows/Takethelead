---
import Icon from "./Icon.astro";
import { getSiteSettings } from "../lib/content";
const site = await getSiteSettings();
---

<div class="mobar" aria-label="Quick contact">
  <a class="btn btn-ghost" href={site.phoneHref}>
    <Icon name="phone" /> Call
  </a>
  <a class="btn btn-red" href="/contact/">Book Free Trial</a>
</div>
