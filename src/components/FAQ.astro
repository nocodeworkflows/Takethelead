---
import { getFaqs } from "../lib/content";
interface Props {
  /** Show only the first N questions (by order). */
  limit?: number;
  /** Group questions under category headings (FAQs page). */
  grouped?: boolean;
}
const { limit, grouped = false } = Astro.props;
const all = await getFaqs();
const faqs = limit ? all.slice(0, limit) : all;

const categories = grouped ? [...new Set(faqs.map((f) => f.category))] : [""];

// FAQ structured data for rich results
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<section class="sec" id="faq">
  <div class="wrap">
    <div class="sec-head center reveal">
      <span class="eyebrow">Good to know</span>
      <h2>Frequently asked questions</h2>
      <p>Everything you need to know before your dog's first visit.</p>
    </div>
    <div class="faq">
      {
        categories.map((cat) => (
          <>
            {grouped && <h3 class="faq-cat">{cat}</h3>}
            {faqs
              .filter((f) => !grouped || f.category === cat)
              .map((f, i) => (
                <details class="acc reveal" open={!grouped && i === 0}>
                  <summary>
                    {f.q}
                    <span class="plus" aria-hidden="true" />
                  </summary>
                  <div class="body">{f.a}</div>
                </details>
              ))}
          </>
        ))
      }
      {limit && all.length > limit && (
        <p class="faq-more"><a href="/faqs/">See all {all.length} questions</a></p>
      )}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</section>

<style>
  .faq-cat { font-size: 1.4rem; color: var(--ink); margin: 2rem 0 0.9rem; }
  .faq-cat:first-child { margin-top: 0; }
  .faq-more { text-align: center; margin-top: 1.2rem; }
  .faq-more a { color: var(--red); font-weight: 700; }
</style>
