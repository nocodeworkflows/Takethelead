---
import { getReviews, getSiteSettings } from "../lib/content";
interface Props { limit?: number; }
const { limit = 6 } = Astro.props;
const site = await getSiteSettings();
const reviews = await getReviews();
const list = reviews.slice(0, limit);
---

<section class="sec reviews" id="reviews">
  <div class="wrap">
    <div class="rev-top reveal">
      <div>
        <span class="eyebrow">In their words</span>
        <h2>Don't just take our word for it</h2>
      </div>
      {site.social.facebook && (
        <a class="rev-score" href={`${site.social.facebook.replace(/\/$/, "")}/reviews`} target="_blank" rel="noopener">
          <div>
            <div class="stars">★★★★★</div>
            <small>Read more reviews on Facebook</small>
          </div>
        </a>
      )}
    </div>

    <div class="rev-grid">
      {
        list.map((r) => (
          <article class="rev reveal">
            <div class="stars">★★★★★</div>
            <p>“{r.text}”</p>
            <div class="who">
              <span class="av">{r.initial}</span>
              <div>
                {r.name}
                <span>{r.where}</span>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="rev-foot">
      {reviews.length > list.length && (
        <a class="btn btn-outline-light" href="/reviews/">Read all {reviews.length} reviews</a>
      )}
      <a class="btn btn-light" href="/contact/">Book a Free Meet &amp; Greet</a>
    </div>
  </div>
</section>
